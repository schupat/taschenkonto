{
  "name": "taschenkonto",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "postinstall": "prisma generate",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/lib/*.test.ts src/lib/services/*.test.ts",
    "test:db": "DATABASE_URL=${DATABASE_URL:-postgresql://test:test@localhost:55432/taschenkonto_test} node --import tsx --test --test-concurrency=1 tests/db/*.test.ts",
    "test:db:up": "docker rm -f taschenkonto-test-db > /dev/null 2>&1; docker run -d --rm --name taschenkonto-test-db -p 55432:5432 -e POSTGRES_USER=test -e POSTGRES_PASSWORD=test -e POSTGRES_DB=taschenkonto_test postgres:17-alpine && sleep 3 && npm run test:db:migrate",
    "test:db:migrate": "DATABASE_URL=${DATABASE_URL:-postgresql://test:test@localhost:55432/taschenkonto_test} prisma migrate deploy",
    "test:db:down": "docker stop taschenkonto-test-db",
    "audit": "npm audit --audit-level=high",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs}": [
      "eslint --fix --max-warnings=0"
    ]
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@prisma/client": "^6.19.2",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "dotenv": "^17.3.1",
    "jose": "^6.1.3",
    "next": "16.3.0",
    "next-auth": "^5.0.0-beta.30",
    "next-intl": "^4.8.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "resend": "^6.9.2",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "eslint-plugin-no-secrets": "^2.2.2",
    "eslint-plugin-security": "^4.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prisma": "^6.19.2",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  }
}
